# Copy this file to backend/.env and add your NVIDIA API key. Everything else works as it is.

# ---------------------------------------------------------------------------
# Database: PostgreSQL with the pgvector extension
# ---------------------------------------------------------------------------
# Local (free): run `docker compose up -d` in the project folder, then keep this default.
# A hosted database (Supabase, Neon...) works too: paste its connection string here.
DATABASE_URL=postgresql://surmore:surmore@localhost:5433/surmore

# ---------------------------------------------------------------------------
# NVIDIA API (https://build.nvidia.com), OpenAI-compatible
# ---------------------------------------------------------------------------
# Your key from build.nvidia.com (starts with nvapi-). Keep it private.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Chat model that writes the answers; any chat model on build.nvidia.com works.
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Embedding model used to index documents and search them.
# If you change this later, click Re-index on existing documents,
# because vectors from different models can't be compared.
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
# Optional: shorter vectors use less database space (e.g. 1024 or 512) if the model supports it.
# Leave blank for the model's default size.
NVIDIA_EMBEDDING_DIMENSIONS=

# NVIDIA retrieval embedding models need input_type=query/passage and truncate=END.
# Set to false if your embedding model rejects those parameters.
NVIDIA_EMBEDDING_SEND_INPUT_TYPE=true
NVIDIA_EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------------------
# OCR (reads scanned pages, images and diagrams into Markdown)
# ---------------------------------------------------------------------------
# A vision model; nvidia/nemotron-parse also works but invents words on diagrams.
NVIDIA_OCR_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# auto   = OCR only PDF pages / slides with no readable text, and image files (default)
# always = OCR every PDF page (slower, one API call per page)
# off    = never use OCR
OCR_MODE=auto
# Pages sent to the OCR model at the same time
OCR_CONCURRENCY=4
# A PDF page with fewer readable characters than this counts as scanned
OCR_MIN_TEXT_CHARS=40

# ---------------------------------------------------------------------------
# Generation
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.7
LLM_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=6
# Number of previous chat messages sent to the model for context
MAX_HISTORY_MESSAGES=8

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=200
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Only for hosts that stop a request after a few minutes: process documents in rounds of this many seconds.
# Leave blank on your own computer, where a document is processed in one go in the background.
PROCESSING_ROUND_SECONDS=

# ---------------------------------------------------------------------------
# Public hosting only. On your own computer, keep these as they are.
# ---------------------------------------------------------------------------
# production: refuses to start unless sign-in is on, hides /docs, adds security headers
ENVIRONMENT=development

# none: no sign-in, single user (fine on your own machine)
# supabase: visitors sign in with Supabase Auth and only see their own data
AUTH_MODE=none
SUPABASE_URL=
# The public "anon" / publishable key (Supabase > Project Settings > API Keys). Safe to expose.
SUPABASE_ANON_KEY=
# Only for older projects still using the shared "JWT secret"; newer projects need nothing here.
SUPABASE_JWT_SECRET=
# Sign-in options shown to visitors; enable the same providers in Supabase > Authentication > Providers
AUTH_PROVIDERS=email,google

# Where original uploaded files are kept: local (this computer) or s3 (any S3-compatible bucket)
STORAGE_BACKEND=local
S3_BUCKET=
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (leave blank for AWS S3)
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Per-user limits so strangers can't run up your NVIDIA usage (0 = unlimited)
LIMIT_CHAT_PER_MINUTE=10
LIMIT_CHAT_PER_DAY=300
LIMIT_OCR_PER_HOUR=30
LIMIT_UPLOADS_PER_DAY=50
LIMIT_KBS_PER_USER=20
LIMIT_DOCUMENTS_PER_USER=200
LIMIT_STORAGE_MB_PER_USER=1000
MAX_FILES_PER_UPLOAD=20
